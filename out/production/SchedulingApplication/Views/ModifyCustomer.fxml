<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="650.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/11.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.ModifyCustomerController">
    <children>
        <Label layoutX="238.0" layoutY="75.0" text="Update Customer">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <Label layoutX="100.0" layoutY="145.0" text="Customer ID">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>
        <Label layoutX="100.0" layoutY="190.0" text="Customer Name">
            <font>
                <Font name="System Bold" size="14.0" />
            </font></Label>
        <Label layoutX="100.0" layoutY="235.0" text="Customer Address">
            <font>
                <Font name="System Bold" size="14.0" />
            </font></Label>
        <Label layoutX="100.0" layoutY="280.0" text="Country">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>
        <Label layoutX="100.0" layoutY="325.0" text="State">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>
        <Label layoutX="100.0" layoutY="370.0" text="Zipcode">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>
        <Label layoutX="100.0" layoutY="415.0" text="Phone Number">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>
        <ComboBox fx:id="CustomerCountry" layoutX="275.0" layoutY="278.0" onAction="#onCountryClicked" prefWidth="150.0" promptText="Select Country" />
        <ComboBox fx:id="CustomerState" layoutX="275.0" layoutY="323.0" prefWidth="150.0" promptText="Select State" />
        <TextField fx:id="CustomerID" disable="true" layoutX="275.0" layoutY="143.0" />
        <TextField fx:id="CustomerName" layoutX="275.0" layoutY="188.0" promptText="Enter Name" />
        <TextField fx:id="CustomerAddress" layoutX="275.0" layoutY="233.0" promptText="Enter Address" />
        <TextField fx:id="CustomerZip" layoutX="275.0" layoutY="368.0" promptText="Enter Zip" />
        <TextField fx:id="CustomerPhone" layoutX="275.0" layoutY="413.0" promptText="Enter Phone #" />
        <Button fx:id="SaveButton" layoutX="156.0" layoutY="504.0" mnemonicParsing="false" onAction="#saveUpdateCustomer" prefHeight="25.0" prefWidth="50.0" text="Save" />
        <Button fx:id="ExitButton" layoutX="372.0" layoutY="504.0" mnemonicParsing="false" onAction="#exitToMain" prefWidth="50.0" text="Exit" />
    </children>
</AnchorPane>
