<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="680.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/11.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.ModifyAppointmentController">
    <children>
        <Label layoutX="238.0" layoutY="50.0" text="Update Appointment">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <Label layoutX="100.0" layoutY="125.0" text="Appointment ID">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>
        <Label layoutX="100.0" layoutY="170.0" text="Customer ID">
            <font>
                <Font name="System Bold" size="14.0" />
            </font></Label>
        <Label layoutX="100.0" layoutY="215.0" text="User ID">
            <font>
                <Font name="System Bold" size="14.0" />
            </font></Label>
        <Label layoutX="100.0" layoutY="260.0" text="Title">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>
        <Label layoutX="100.0" layoutY="305.0" text="Description">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>
        <Label layoutX="100.0" layoutY="350.0" text="Location">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>
        <Label layoutX="100.0" layoutY="395.0" text="Contact">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>
        <TextField fx:id="AppointmentID" disable="true" layoutX="275.0" layoutY="125.0" />
        <TextField fx:id="Location" layoutX="275.0" layoutY="350.0" promptText="Enter Location" />
        <Button fx:id="SaveButton" layoutX="125.0" layoutY="625.0" mnemonicParsing="false" onAction="#saveUpdateAppointment" prefHeight="25.0" prefWidth="50.0" text="Save" />
        <Button fx:id="ExitButton" layoutX="375.0" layoutY="625.0" mnemonicParsing="false" onAction="#exitToMain" prefWidth="50.0" text="Exit" />
        <TextField fx:id="Title" layoutX="275.0" layoutY="260.0" promptText="Enter Title" />
        <TextField fx:id="Description" layoutX="275.0" layoutY="305.0" promptText="Enter Description" />
        <Label layoutX="100.0" layoutY="440.0" text="Type">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>
        <TextField fx:id="Type" layoutX="275.0" layoutY="440.0" promptText="Enter Type" />
        <Label layoutX="100.0" layoutY="485.0" text="Date">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>
        <Label layoutX="100.0" layoutY="530.0" text="Start Time">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>
        <Label layoutX="100.0" layoutY="575.0" text="End Time">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>
        <DatePicker fx:id="datePicker" layoutX="275.0" layoutY="483.0" onAction="#appointmentDate" promptText="Select Date" />
        <ComboBox fx:id="startTimeComboBox" layoutX="275.0" layoutY="528.0" prefHeight="25.0" prefWidth="149.0" promptText="Select Start Time" />
        <ComboBox fx:id="endTimeComboBox" layoutX="275.0" layoutY="573.0" prefHeight="25.0" prefWidth="149.0" promptText="Select End Time" />
      <ComboBox fx:id="CustomerID" layoutX="275.0" layoutY="168.0" prefWidth="150.0" promptText="Select Customer ID" />
      <ComboBox fx:id="UserID" layoutX="275.0" layoutY="213.0" prefWidth="150.0" promptText="Select User ID" />
      <ComboBox fx:id="ContactID" layoutX="275.0" layoutY="393.0" prefWidth="150.0" promptText="Select Contact" />
    </children>
</AnchorPane>
